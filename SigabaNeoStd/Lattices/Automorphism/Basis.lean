import SigabaNeoStd.Lattices.Automorphism.Interface
import SigabaNeoStd.Lattices.Automorphism.Sieve
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Data.Nat.Bitwise
import Mathlib.Tactic.Linarith

/-!
# The binary basis of `H = {1 + j · 2n/W : j < W} ⊆ (ℤ/2n)^×`

For `W = 2^b` with `2W ∣ n` (so `2n/W = 4c` and `W < n`), the group `H` is cyclic, generated by
`g := gGen n W = 1 + 2n/W` (§3.2 of ePrint 2026/2539), and `g_j := g^(2^j)` (`j < b`) is its binary
basis: every element of `H` is `g^i = ∏_{j<b, bit j of i} g^(2^j)` for a unique `i < W`.

* `exists_one_add_pow_two_pow`: `(1 + m)^(2^t) = 1 + 2^t m u` with `u` odd, when `4 ∣ m`.
* `orderOf_gGen`: `g` has order `W` in `ZMod (2n)`.
* `pow_gGen_mod_injOn`, `pow_gGen_mod_eq_hIdx`, `image_pow_gGen`, **`bijOn_pow_gGen`**:
  `i ↦ g^i mod 2n` is a bijection from `range W` onto `{hIdx n W j mod 2n : j < W}`.
* `sum_two_pow_testBit`, **`pow_eq_prod_bits`**: `x^i = ∏_{j<b, bit j of i} x^(2^j)` for `i < 2^b`;
  `range_two_pow_succ`: the rounds `H_{j+1} = H_j ∪ H_j · g^(2^j)` on exponents.
-/

namespace SigabaNeo.Lattices

open Finset

/-- The generator `g = 1 + 2n/W` of `H`. -/
def gGen (n W : ℕ) : ℕ := 1 + 2 * n / W

theorem gGen_eq_hIdx (n W : ℕ) : gGen n W = hIdx n W 1 := by simp [gGen, hIdx]

theorem odd_gGen {n W : ℕ} (hW : W ∣ n) : Odd (gGen n W) := by
  rw [gGen_eq_hIdx]; exact odd_hIdx hW 1

theorem odd_gGen_pow {n W : ℕ} (hW : W ∣ n) (i : ℕ) : Odd (gGen n W ^ i) := (odd_gGen hW).pow

/-- `(1 + m)^(2^t) = 1 + 2^t m u` with `u` odd, when `4 ∣ m`. -/
theorem exists_one_add_pow_two_pow {m : ℕ} (hm : 4 ∣ m) (t : ℕ) :
    ∃ u, Odd u ∧ (1 + m) ^ (2 ^ t) = 1 + 2 ^ t * m * u := by
  obtain ⟨c, rfl⟩ := hm
  induction t with
  | zero => exact ⟨1, odd_one, by simp⟩
  | succ t ih =>
    obtain ⟨u, hu, h⟩ := ih
    refine ⟨u + 2 ^ (t + 1) * c * u ^ 2, hu.add_even ⟨2 ^ t * c * u ^ 2, by ring⟩, ?_⟩
    rw [pow_succ, pow_mul, h]; ring

section Group

variable {n b : ℕ}

/-- With `n = 2 · 2^b · c`: `2n/2^b = 4c`. -/
theorem two_n_div_eq {c : ℕ} : 2 * (2 * 2 ^ b * c) / 2 ^ b = 4 * c := by
  rw [show 2 * (2 * 2 ^ b * c) = 2 ^ b * (4 * c) by ring, Nat.mul_div_cancel_left _ (by positivity)]

/-- **`g` has order `W = 2^b` modulo `2n`**, for `2W ∣ n`, `0 < n`. -/
theorem orderOf_gGen (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) :
    orderOf ((gGen n (2 ^ b) : ℕ) : ZMod (2 * n)) = 2 ^ b := by
  obtain ⟨c, rfl⟩ := h
  have hc : 0 < c := by rcases Nat.eq_zero_or_pos c with rfl | h <;> simp_all
  have hg : gGen (2 * 2 ^ b * c) (2 ^ b) = 1 + 4 * c := by rw [gGen, two_n_div_eq]
  have h2n : 2 * (2 * 2 ^ b * c) = 2 ^ b * (4 * c) := by ring
  rw [hg]
  -- `x^(2^t)` in terms of naturals
  have hpow : ∀ t, ((1 + 4 * c : ℕ) : ZMod (2 * (2 * 2 ^ b * c))) ^ (2 ^ t) = 1 ↔
      (1 + 4 * c) ^ (2 ^ t) % (2 * (2 * 2 ^ b * c)) = 1 % (2 * (2 * 2 ^ b * c)) := fun t => by
    rw [← Nat.cast_pow, show (1 : ZMod (2 * (2 * 2 ^ b * c))) = ((1 : ℕ) : ZMod _) from
      Nat.cast_one.symm, ZMod.natCast_eq_natCast_iff']
  rcases b with _ | b
  · rw [pow_zero, orderOf_eq_one_iff]
    have key : (1 + 4 * c) ^ (2 ^ 0) % (2 * (2 * 2 ^ 0 * c)) = 1 % (2 * (2 * 2 ^ 0 * c)) := by
      rw [show 2 * (2 * 2 ^ 0 * c) = 4 * c by ring, pow_zero, pow_one, Nat.add_mod_right]
    have := (hpow 0).mpr key
    rwa [pow_zero, pow_one] at this
  · refine orderOf_eq_prime_pow (p := 2) ?_ ?_
    · rw [hpow]
      obtain ⟨u, hu, hu'⟩ := exists_one_add_pow_two_pow (m := 4 * c) ⟨c, rfl⟩ b
      rw [hu']
      intro heq
      have hmod : 2 ^ b * (4 * c) * u ≡ 0 [MOD 2 * (2 * 2 ^ (b + 1) * c)] :=
        Nat.ModEq.add_left_cancel' 1 (by simpa [Nat.ModEq] using heq)
      rw [Nat.modEq_zero_iff_dvd, show 2 * (2 * 2 ^ (b + 1) * c) = 2 ^ b * (4 * c) * 2 by ring]
        at hmod
      have h2 : 2 ∣ u := Nat.dvd_of_mul_dvd_mul_left (by positivity) hmod
      exact (Nat.not_even_iff_odd.mpr hu) (even_iff_two_dvd.mpr h2)
    · rw [hpow]
      obtain ⟨u, -, hu'⟩ := exists_one_add_pow_two_pow (m := 4 * c) ⟨c, rfl⟩ (b + 1)
      rw [hu', show 2 ^ (b + 1) * (4 * c) * u = 2 * (2 * 2 ^ (b + 1) * c) * u by ring,
        Nat.add_mul_mod_self_left]

/-- `i ↦ g^i mod 2n` is injective on `[0, W)`. -/
theorem pow_gGen_mod_injOn (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) :
    Set.InjOn (fun i => gGen n (2 ^ b) ^ i % (2 * n)) (range (2 ^ b)) := by
  intro i hi i' hi' heq
  have heq' : ((gGen n (2 ^ b) : ℕ) : ZMod (2 * n)) ^ i = ((gGen n (2 ^ b) : ℕ) : ZMod (2 * n)) ^ i' := by
    rw [← Nat.cast_pow, ← Nat.cast_pow, ZMod.natCast_eq_natCast_iff']; exact heq
  have hi2 : i < 2 ^ b := by simpa using hi
  have hi2' : i' < 2 ^ b := by simpa using hi'
  exact pow_injOn_Iio_orderOf (by rw [Set.mem_Iio, orderOf_gGen h hn]; exact hi2)
    (by rw [Set.mem_Iio, orderOf_gGen h hn]; exact hi2') heq'

theorem hIdx_lt (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) {j : ℕ} (hj : j < 2 ^ b) :
    hIdx n (2 ^ b) j < 2 * n := by
  obtain ⟨c, rfl⟩ := h
  have hc : 0 < c := by rcases Nat.eq_zero_or_pos c with rfl | h <;> simp_all
  rw [hIdx, two_n_div_eq]
  have : (j + 1) * (4 * c) ≤ 2 ^ b * (4 * c) := Nat.mul_le_mul_right _ hj
  nlinarith

/-- `g^i mod 2n = hIdx n W j` for `j = (g^i mod 2n) / (2n/W) < W`. -/
theorem pow_gGen_mod_eq_hIdx (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) (i : ℕ) :
    (gGen n (2 ^ b) ^ i % (2 * n)) / (2 * n / 2 ^ b) < 2 ^ b ∧
      hIdx n (2 ^ b) ((gGen n (2 ^ b) ^ i % (2 * n)) / (2 * n / 2 ^ b)) =
        gGen n (2 ^ b) ^ i % (2 * n) := by
  obtain ⟨c, rfl⟩ := h
  have hc : 0 < c := by rcases Nat.eq_zero_or_pos c with rfl | h <;> simp_all
  rw [gGen, hIdx, two_n_div_eq]
  have h2n : 2 * (2 * 2 ^ b * c) = 2 ^ b * (4 * c) := by ring
  rw [h2n]
  set x := (1 + 4 * c) ^ i % (2 ^ b * (4 * c)) with hx
  have hmod : x % (4 * c) = 1 := by
    rw [hx, Nat.mod_mod_of_dvd _ (Dvd.intro_left _ rfl)]
    have : (1 + 4 * c) ^ i ≡ 1 ^ i [MOD 4 * c] :=
      Nat.ModEq.pow i (by simp [Nat.ModEq, Nat.add_mod_right])
    rw [one_pow] at this
    rw [this, Nat.mod_eq_of_lt (by omega)]
  have hlt : x < 2 ^ b * (4 * c) := Nat.mod_lt _ (by positivity)
  refine ⟨(Nat.div_lt_iff_lt_mul (by positivity)).mpr (by linarith), ?_⟩
  have := Nat.div_add_mod x (4 * c)
  rw [hmod] at this
  linarith

/-- The image of `i ↦ g^i mod 2n` on `[0, W)` is `{hIdx n W j mod 2n : j < W}`. -/
theorem image_pow_gGen (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) :
    (range (2 ^ b)).image (fun i => gGen n (2 ^ b) ^ i % (2 * n)) =
      (range (2 ^ b)).image (fun j => hIdx n (2 ^ b) j % (2 * n)) := by
  refine Finset.eq_of_subset_of_card_le ?_ ?_
  · intro x hx
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨hj, hj'⟩ := pow_gGen_mod_eq_hIdx h hn i
    refine Finset.mem_image.mpr ⟨_, Finset.mem_range.mpr hj, ?_⟩
    rw [hj', Nat.mod_mod]
  · rw [Finset.card_image_of_injOn (pow_gGen_mod_injOn h hn)]
    exact (Finset.card_image_le).trans (by simp)

/-- **`i ↦ g^i mod 2n` is a bijection from `[0, W)` onto `{hIdx n W j mod 2n : j < W}`.** -/
theorem bijOn_pow_gGen (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) :
    Set.BijOn (fun i => gGen n (2 ^ b) ^ i % (2 * n)) (range (2 ^ b))
      ((range (2 ^ b)).image (fun j => hIdx n (2 ^ b) j % (2 * n)) : Finset ℕ) := by
  have := (pow_gGen_mod_injOn h hn).bijOn_image
  rwa [← Finset.coe_image, image_pow_gGen h hn] at this

/-- `j ↦ hIdx n W j mod 2n` is injective on `[0, W)`. -/
theorem hIdx_mod_injOn (h : 2 * 2 ^ b ∣ n) (hn : 0 < n) :
    Set.InjOn (fun j => hIdx n (2 ^ b) j % (2 * n)) (range (2 ^ b)) := by
  intro j hj j' hj' heq
  have hj2 : j < 2 ^ b := by simpa using hj
  have hj2' : j' < 2 ^ b := by simpa using hj'
  have heq' : hIdx n (2 ^ b) j = hIdx n (2 ^ b) j' := by
    simp only at heq
    rwa [Nat.mod_eq_of_lt (hIdx_lt h hn hj2), Nat.mod_eq_of_lt (hIdx_lt h hn hj2')] at heq
  obtain ⟨c, rfl⟩ := h
  have hc : 0 < c := by rcases Nat.eq_zero_or_pos c with rfl | h <;> simp_all
  rw [hIdx, hIdx, two_n_div_eq] at heq'
  exact Nat.eq_of_mul_eq_mul_right (by omega : 0 < 4 * c) (by omega)

end Group

section Bits

/-- The binary digits of `i` below `b` sum to `i mod 2^b`. -/
theorem sum_two_pow_testBit (i b : ℕ) :
    ∑ j ∈ (range b).filter (fun j => i.testBit j), 2 ^ j = i % 2 ^ b := by
  induction b with
  | zero => simp [Nat.mod_one]
  | succ b ih =>
    rw [Finset.range_add_one, Finset.filter_insert]
    have hsplit : i % 2 ^ (b + 1) = i % 2 ^ b + 2 ^ b * (i / 2 ^ b % 2) := by
      rw [pow_succ, Nat.mod_mul]
    have hnot : b ∉ (range b).filter (fun j => i.testBit j) := by simp
    by_cases hb : i.testBit b
    · rw [if_pos hb, Finset.sum_insert hnot, ih, hsplit]
      rw [Nat.testBit_eq_decide_div_mod_eq, decide_eq_true_eq] at hb
      rw [hb]; ring
    · rw [if_neg hb, ih, hsplit]
      rw [Nat.testBit_eq_decide_div_mod_eq, decide_eq_true_eq] at hb
      have : i / 2 ^ b % 2 = 0 := by omega
      rw [this]; ring

/-- **The binary basis decomposition**: `x^i = ∏_{j<b, bit j of i} x^(2^j)` for `i < 2^b`. -/
theorem pow_eq_prod_bits {M : Type*} [CommMonoid M] (x : M) {i b : ℕ} (hi : i < 2 ^ b) :
    x ^ i = ∏ j ∈ (range b).filter (fun j => i.testBit j), x ^ (2 ^ j) := by
  rw [Finset.prod_pow_eq_pow_sum, sum_two_pow_testBit, Nat.mod_eq_of_lt hi]

/-- The rounds on exponents: `[0, 2^(j+1)) = [0, 2^j) ∪ (2^j + [0, 2^j))`, i.e.
`H_{j+1} = H_j ∪ H_j · g^(2^j)`. -/
theorem range_two_pow_succ (j : ℕ) :
    range (2 ^ (j + 1)) = range (2 ^ j) ∪ (range (2 ^ j)).image (fun i => i + 2 ^ j) := by
  ext i
  simp only [Finset.mem_union, Finset.mem_range, Finset.mem_image, pow_succ]
  constructor
  · intro h
    by_cases hi : i < 2 ^ j
    · exact Or.inl hi
    · exact Or.inr ⟨i - 2 ^ j, by omega, by omega⟩
  · rintro (h | ⟨i', h, rfl⟩) <;> omega

end Bits

end SigabaNeo.Lattices
