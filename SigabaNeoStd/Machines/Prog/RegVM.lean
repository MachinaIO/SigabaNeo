import SigabaNeoStd.Machines.Prog.RegMacros
import SigabaNeoStd.Machines.Prog.RegVMAttr

/-!
# A register machine compiled to tape programs

`RegVM.Code` is a small structured language over

* `nS` *scalar registers* holding naturals (in unary on a tape),
* `nL` *list registers* holding lists of naturals (FIFO, fixed capacity `C`),
* a *source stream* of naturals read one at a time (`rdsrc`, unary blocks of width `W`),
* an *output* word, to which `nand d a b` appends the unary words (width `W`) of the two
  register values `a`, `b` and stores in `d` the position `n + 1 + t` of the new gate (`t` counts
  the gates emitted so far). Values `a ≥ n + 1 + t` are emitted as `n` (`fixv`).

It is designed to write the gate tapes of straight-line programs (`gatesW`) generated by
first-order builders. `exec E c σ` is its semantics on abstract states `St`; it is *exact*: it
describes the tape behaviour for every state (scalars saturate at the template width `M`, a push
into a full list is ignored).

`compile c j : Prog K` (`K = 119` tapes) places the registers on fixed tapes; loops `rep a body`
use the counter tape of their nesting depth `j`. **`run_compile`**: on the encoding `enc E σ ctr`
of a state, the program ends in the encoding of `exec E c σ`.
-/

set_option linter.unusedSimpArgs false

namespace SigabaNeo.Tape

namespace RegVM

open Prog
open scoped Prog

/-! ### Sizes and tapes -/

/-- Scalar registers. -/
abbrev nS : ℕ := 64
/-- List registers. -/
abbrev nL : ℕ := 24
/-- Loop depth. -/
abbrev nD : ℕ := 16
/-- Tapes: 7 special, 8 scratch, `nD` counters, the scalars, the lists. -/
abbrev K : ℕ := 15 + nD + nS + nL

/-- Arithmetic on the sizes. -/
macro "kdim" : tactic => `(tactic| (simp only [K, nD, nS, nL] at *; omega))

abbrev SR := Fin nS
abbrev LR := Fin nL

/-- The output register. -/
def tOUT : Fin K := ⟨0, by decide⟩
/-- `|pad| - |out|` in unary. -/
def tOC : Fin K := ⟨1, by decide⟩
/-- `M - (n + 1 + t)` in unary. -/
def tCO : Fin K := ⟨2, by decide⟩
/-- The template `M`. -/
def tT : Fin K := ⟨3, by decide⟩
/-- The template `W`. -/
def tW : Fin K := ⟨4, by decide⟩
/-- The template `n`. -/
def tN : Fin K := ⟨5, by decide⟩
/-- The source stream. -/
def tSRC : Fin K := ⟨6, by decide⟩
/-- Scratch tapes. -/
def tX (i : Fin 8) : Fin K := ⟨7 + i.val, by have := i.isLt; kdim⟩
/-- Loop counters. -/
def tC (j : Fin nD) : Fin K := ⟨15 + j.val, by have := j.isLt; kdim⟩
/-- Scalar registers. -/
def tR (r : SR) : Fin K := ⟨31 + r.val, by have := r.isLt; kdim⟩
/-- List registers. -/
def tL (l : LR) : Fin K := ⟨95 + l.val, by have := l.isLt; kdim⟩

/-! ### Code and semantics -/

/-- The instructions. -/
inductive Code where
  /-- Emit the gate `(a, b)`; `d :=` its position. -/
  | nand (d a b : SR)
  /-- `d := n` (the position of the wire `1`). -/
  | one (d : SR)
  | zero (d : SR)
  | mov (d a : SR)
  | inc (d : SR)
  | add (d a : SR)
  /-- Truncated subtraction. -/
  | sub (d a : SR)
  | lnil (l : LR)
  /-- Append `a` to `l` (ignored if `l` is full). -/
  | lpush (l : LR) (a : SR)
  /-- `d :=` head of `l` (`0` if empty); drop it. -/
  | lpop (d : SR) (l : LR)
  | lmov (l l' : LR)
  /-- `d :=` next value of the source (`0` if none). -/
  | rdsrc (d : SR)
  | skip
  | seq (p q : Code)
  /-- `p` if `a < b`, else `q`. -/
  | ifLt (a b : SR) (p q : Code)
  /-- Repeat `body`, as many times as the value of `a` at the start. -/
  | rep (a : SR) (body : Code)

/-- The parameters: the position `n` of `1`, the unary width `W`, the template width `M`, the
list capacity `C`, the initial content of the output register. -/
structure Env where
  n : ℕ
  W : ℕ
  M : ℕ
  C : ℕ
  pad : List Bool

/-- Abstract states. -/
structure St where
  out : List Bool
  t : ℕ
  sc : SR → ℕ
  ls : LR → List ℕ
  src : List ℕ

/-- `j` in unary on `W` bits. -/
def uw (W j : ℕ) : List Bool := List.replicate j true ++ List.replicate (W - j) false

@[simp, regvm] theorem length_uw {W j : ℕ} (h : j ≤ W) : (uw W j).length = W := by
  simp [uw]; omega

/-- The emitted position of a value: values not below the next gate are read as `1`. -/
def fixv (E : Env) (t x : ℕ) : ℕ := if min (E.n + 1 + t) E.M ≤ x then E.n else x

/-- **The semantics.** -/
def exec (E : Env) : Code → St → St
  | .nand d a b, σ =>
    { σ with out := σ.out ++ uw E.W (fixv E σ.t (σ.sc a)) ++ uw E.W (fixv E σ.t (σ.sc b)), t := σ.t + 1, sc := Function.update σ.sc d (min (E.n + 1 + σ.t) E.M) }
  | .one d, σ => { σ with sc := Function.update σ.sc d E.n }
  | .zero d, σ => { σ with sc := Function.update σ.sc d 0 }
  | .mov d a, σ => { σ with sc := Function.update σ.sc d (σ.sc a) }
  | .inc d, σ => { σ with sc := Function.update σ.sc d (min (σ.sc d + 1) E.M) }
  | .add d a, σ => { σ with sc := Function.update σ.sc d (min (σ.sc d + σ.sc a) E.M) }
  | .sub d a, σ => { σ with sc := Function.update σ.sc d (σ.sc d - σ.sc a) }
  | .lnil l, σ => { σ with ls := Function.update σ.ls l [] }
  | .lpush l a, σ => { σ with ls := Function.update σ.ls l (if (σ.ls l).length < E.C then
      σ.ls l ++ [min (σ.sc a) E.M] else σ.ls l) }
  | .lpop d l, σ =>
    { σ with sc := Function.update σ.sc d ((σ.ls l).headD 0), ls := Function.update σ.ls l (σ.ls l).tail }
  | .lmov l l', σ => { σ with ls := Function.update σ.ls l (σ.ls l') }
  | .rdsrc d, σ =>
    { σ with sc := Function.update σ.sc d (σ.src.headD 0), src := σ.src.tail }
  | .skip, σ => σ
  | .seq p q, σ => exec E q (exec E p σ)
  | .ifLt a b p q, σ => if σ.sc a < σ.sc b then exec E p σ else exec E q σ
  | .rep a body, σ => (exec E body)^[σ.sc a] σ

/-- The loop depth of a code. -/
def depth : Code → ℕ
  | .seq p q => max (depth p) (depth q)
  | .ifLt _ _ p q => max (depth p) (depth q)
  | .rep _ body => depth body + 1
  | _ => 0

/-- The number of instructions of a code. -/
def size : Code → ℕ
  | .seq p q => size p + size q
  | .ifLt _ _ p q => size p + size q + 1
  | .rep _ body => size body + 1
  | _ => 1

theorem one_le_size : ∀ c : Code, 1 ≤ size c
  | .seq p _ => (one_le_size p).trans (Nat.le_add_right _ _)
  | .ifLt _ _ _ _ | .rep _ _ => Nat.le_add_left _ _
  | .nand _ _ _ | .one _ | .zero _ | .mov _ _ | .inc _ | .add _ _ | .sub _ _ | .lnil _
  | .lpush _ _ | .lpop _ _ | .lmov _ _ | .rdsrc _ | .skip => le_rfl

/-! ### The tape encoding -/

/-- A list element: a marker bit, then the value in unary on `M` bits. -/
def blk (M x : ℕ) : List Bool := true :: uw M x

/-- A list register: free blocks of `false`, then the elements. -/
def lenc (E : Env) (L : List ℕ) : List Bool :=
  List.replicate ((E.C - L.length) * (E.M + 1)) false ++ (L.map (blk E.M)).flatten

/-- The source stream. -/
def senc (E : Env) (src : List ℕ) : List Bool := (src.map (uw E.W)).flatten

/-- **The encoding of a state**, with the loop counters `ctr`. -/
def enc (E : Env) (σ : St) (ctr : Fin nD → List Bool) : Store K := fun i =>
  if i.val = 0 then (E.pad ++ σ.out).drop σ.out.length
  else if i.val = 1 then List.replicate (E.pad.length - σ.out.length) true
  else if i.val = 2 then List.replicate (E.M - (E.n + 1 + σ.t)) true
  else if i.val = 3 then List.replicate E.M true
  else if i.val = 4 then List.replicate E.W true
  else if i.val = 5 then List.replicate E.n true
  else if i.val = 6 then senc E σ.src
  else if i.val < 15 then []
  else if h : i.val < 31 then ctr ⟨i.val - 15, by kdim⟩
  else if h : i.val < 95 then List.replicate (σ.sc ⟨i.val - 31, by kdim⟩) true
  else lenc E (σ.ls ⟨i.val - 95, by have := i.isLt; kdim⟩)

section EncLemmas

variable (E : Env) (σ : St) (ctr : Fin nD → List Bool)

@[simp, regvm] theorem enc_OUT : enc E σ ctr tOUT = (E.pad ++ σ.out).drop σ.out.length := rfl
@[simp, regvm] theorem enc_OC : enc E σ ctr tOC = List.replicate (E.pad.length - σ.out.length) true := rfl
@[simp, regvm] theorem enc_CO : enc E σ ctr tCO = List.replicate (E.M - (E.n + 1 + σ.t)) true := rfl
@[simp, regvm] theorem enc_T : enc E σ ctr tT = List.replicate E.M true := rfl
@[simp, regvm] theorem enc_W : enc E σ ctr tW = List.replicate E.W true := rfl
@[simp, regvm] theorem enc_N : enc E σ ctr tN = List.replicate E.n true := rfl
@[simp, regvm] theorem enc_SRC : enc E σ ctr tSRC = senc E σ.src := rfl

@[simp, regvm] theorem enc_X (i : Fin 8) : enc E σ ctr (tX i) = [] := by
  have := i.isLt
  unfold enc
  simp only [show ¬(7 + i.val = 0) by omega, show ¬(7 + i.val = 1) by omega, show ¬(7 + i.val = 2) by omega, show ¬(7 + i.val = 3) by omega, show ¬(7 + i.val = 4) by omega, show ¬(7 + i.val = 5) by omega, show ¬(7 + i.val = 6) by omega, show (7 + i.val < 15) by omega, ↓reduceIte, ↓reduceDIte, tX]

@[simp, regvm] theorem enc_C (j : Fin nD) : enc E σ ctr (tC j) = ctr j := by
  have := j.isLt
  simp only [nD] at this
  unfold enc
  simp only [show ¬(15 + j.val = 0) by omega, show ¬(15 + j.val = 1) by omega, show ¬(15 + j.val = 2) by omega, show ¬(15 + j.val = 3) by omega, show ¬(15 + j.val = 4) by omega, show ¬(15 + j.val = 5) by omega, show ¬(15 + j.val = 6) by omega, show ¬(15 + j.val < 15) by omega, show (15 + j.val < 31) by omega, ↓reduceIte, ↓reduceDIte, tC]
  congr 1; ext; simp

@[simp, regvm] theorem enc_R (r : SR) : enc E σ ctr (tR r) = List.replicate (σ.sc r) true := by
  have := r.isLt
  simp only [nS] at this
  unfold enc
  simp only [show ¬(31 + r.val = 0) by omega, show ¬(31 + r.val = 1) by omega, show ¬(31 + r.val = 2) by omega, show ¬(31 + r.val = 3) by omega, show ¬(31 + r.val = 4) by omega, show ¬(31 + r.val = 5) by omega, show ¬(31 + r.val = 6) by omega, show ¬(31 + r.val < 15) by omega, show ¬(31 + r.val < 31) by omega, show (31 + r.val < 95) by omega, ↓reduceIte, ↓reduceDIte, tR]
  congr 2; ext; simp

@[simp, regvm] theorem enc_L (l : LR) : enc E σ ctr (tL l) = lenc E (σ.ls l) := by
  have := l.isLt
  simp only [nL] at this
  unfold enc
  simp only [show ¬(95 + l.val = 0) by omega, show ¬(95 + l.val = 1) by omega, show ¬(95 + l.val = 2) by omega, show ¬(95 + l.val = 3) by omega, show ¬(95 + l.val = 4) by omega, show ¬(95 + l.val = 5) by omega, show ¬(95 + l.val = 6) by omega, show ¬(95 + l.val < 15) by omega, show ¬(95 + l.val < 31) by omega, show ¬(95 + l.val < 95) by omega, ↓reduceIte, ↓reduceDIte, tL]
  congr 2; ext; simp

end EncLemmas

/-! ### Distinct tapes -/

theorem tape_cases (i : Fin K) :
    i = tOUT ∨ i = tOC ∨ i = tCO ∨ i = tT ∨ i = tW ∨ i = tN ∨ i = tSRC ∨ (∃ j, i = tX j) ∨
      (∃ j, i = tC j) ∨ (∃ r, i = tR r) ∨ ∃ l, i = tL l := by
  obtain ⟨v, hv⟩ := i
  simp only [K, nD, nS, nL] at hv
  simp only [tOUT, tOC, tCO, tT, tW, tN, tSRC, tX, tC, tR, tL, Fin.ext_iff]
  rcases (by omega : v < 7 ∨ (7 ≤ v ∧ v < 15) ∨ (15 ≤ v ∧ v < 31) ∨ (31 ≤ v ∧ v < 95) ∨ 95 ≤ v)
    with h | h | h | h | h
  · interval_cases v <;> simp
  · right; right; right; right; right; right; right; left
    exact ⟨⟨v - 7, by omega⟩, by simp; omega⟩
  · right; right; right; right; right; right; right; right; left
    exact ⟨⟨v - 15, by simp only [nD]; omega⟩, by simp; omega⟩
  · right; right; right; right; right; right; right; right; right; left
    exact ⟨⟨v - 31, by simp only [nS]; omega⟩, by simp; omega⟩
  · right; right; right; right; right; right; right; right; right; right
    exact ⟨⟨v - 95, by simp only [nL]; omega⟩, by simp; omega⟩

@[simp, regvm] theorem tX_inj {i j : Fin 8} : tX i = tX j ↔ i = j := by
  simp [tX, Fin.ext_iff]
@[simp, regvm] theorem tC_inj {i j : Fin nD} : tC i = tC j ↔ i = j := by
  simp [tC, Fin.ext_iff]
@[simp, regvm] theorem tR_inj {i j : SR} : tR i = tR j ↔ i = j := by
  simp [tR, Fin.ext_iff]
@[simp, regvm] theorem tL_inj {i j : LR} : tL i = tL j ↔ i = j := by
  simp [tL, Fin.ext_iff]

/-- The value of a tape name. -/
theorem val_tX (i : Fin 8) : (tX i).val = 7 + i.val := rfl
theorem val_tC (i : Fin nD) : (tC i).val = 15 + i.val := rfl
theorem val_tR (i : SR) : (tR i).val = 31 + i.val := rfl
theorem val_tL (i : LR) : (tL i).val = 95 + i.val := rfl

/-- Tapes are distinct when their values are. -/
theorem ne_of_val {a b : Fin K} (h : a.val ≠ b.val) : a ≠ b := fun e => h (congrArg Fin.val e)
