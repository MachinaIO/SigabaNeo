{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A theorem node's metadata (dag/Theorems/Thm_<slug>.json)",
 "type": "object",
 "required": [
  "name",
  "title"
 ],
 "additionalProperties": false,
 "properties": {
  "name": {
   "type": "string",
   "pattern": "[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*"
  },
  "title": {
   "type": "string",
   "maxLength": 200
  },
  "statement": {
   "type": "string",
   "maxLength": 20000
  },
  "tags": {
   "type": "array",
   "maxItems": 20,
   "items": {
    "type": "string",
    "pattern": "[a-z0-9][a-z0-9-]{0,39}"
   }
  },
  "source": {
   "type": "string",
   "maxLength": 2000
  }
 }
}
