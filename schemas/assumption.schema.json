{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A registered assumption (dag/Assumptions/<slug>/Asm.json)",
 "type": "object",
 "required": [
  "name",
  "module",
  "title",
  "rationale"
 ],
 "additionalProperties": false,
 "properties": {
  "name": {
   "type": "string",
   "pattern": "[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*",
   "maxLength": 300,
   "description": "The Lean constant, of type SigabaNeo.Assumption; <slug> is it with . replaced by _"
  },
  "module": {
   "type": "string",
   "pattern": "[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*",
   "maxLength": 300,
   "description": "The module that declares it: Definitions.Def_<name> or a std module"
  },
  "title": {
   "type": "string",
   "maxLength": 200
  },
  "description": {
   "type": "string",
   "maxLength": 20000
  },
  "rationale": {
   "type": "string",
   "maxLength": 20000,
   "description": "Why the initial security function H is claimed: the best known attacks and their cost"
  },
  "source": {
   "type": "string",
   "maxLength": 2000
  },
  "tags": {
   "type": "array",
   "maxItems": 20,
   "items": {
    "type": "string",
    "pattern": "[a-z0-9][a-z0-9-]{0,39}"
   }
  }
 }
}
