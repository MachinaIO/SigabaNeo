{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "The verifier's result (dag_verify.py verify)",
 "type": "object",
 "required": [
  "ok",
  "env",
  "items"
 ],
 "additionalProperties": false,
 "properties": {
  "ok": {
   "type": "boolean"
  },
  "env": {
   "type": "string",
   "pattern": "[a-z0-9][a-z0-9.-]{0,63}"
  },
  "fingerprint": {
   "type": "string",
   "pattern": "[0-9a-f]{64}"
  },
  "std": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 100
  },
  "items": {
   "type": "array",
   "maxItems": 400,
   "items": {
    "type": "object",
    "required": [
     "path",
     "kind",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string",
      "maxLength": 300
     },
     "kind": {
      "enum": [
       "definition",
       "theorem",
       "solution",
       "note",
       "assumption",
       "strength"
      ]
     },
     "name": {
      "type": "string",
      "maxLength": 300
     },
     "status": {
      "enum": [
       "OK",
       "ACCEPTED",
       "SKETCH_ACCEPTED",
       "CE",
       "WA",
       "SORRY",
       "FAILED",
       "DUPLICATE",
       "LINT",
       "ERROR"
      ]
     },
     "message": {
      "type": "string",
      "maxLength": 20000
     },
     "id": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
     },
     "hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
     },
     "duplicate_of": {
      "type": "string",
      "maxLength": 300
     },
     "theorem": {
      "type": "string",
      "maxLength": 300
     },
     "proof_type": {
      "enum": [
       "prove",
       "disprove"
      ]
     },
     "uses": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "string",
       "maxLength": 300
      }
     },
     "std": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "[0-9a-f]{64}"
      }
     },
     "assumption": {
      "type": "string",
      "maxLength": 300
     },
     "version": {
      "type": "integer",
      "minimum": 1
     },
     "H": {
      "type": "string",
      "maxLength": 300
     },
     "lowering": {
      "type": "string",
      "maxLength": 300
     }
    }
   },
   "minItems": 1
  },
  "revision": {
   "type": "string",
   "pattern": "[0-9a-f]{40}"
  }
 }
}
