{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "DAG nodes promoted to std (meta/promotions.json)",
 "type": "object",
 "required": [
  "promotions"
 ],
 "additionalProperties": false,
 "properties": {
  "promotions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "node",
     "std"
    ],
    "additionalProperties": false,
    "properties": {
     "node": {
      "type": "string"
     },
     "std": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*"
     },
     "release": {
      "type": "string"
     }
    }
   }
  }
 }
}
