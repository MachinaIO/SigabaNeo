import PE.Impl.ExpLUT.LUT

/-!
# The canonical setting: `H` generated by `g = 1 + 2n/W`

For a ring with automorphisms `E` with `W = 2^b` and `2W ∣ n`, and gadget digits whose gadget
entries are natural numbers (so that the automorphisms fix them), `canonSetting` is the setting
with `idx j = g^j`, `g = gGen n W = 1 + 2n/W` (§3.2). The group law in exponent form holds because
`g` has order `W` modulo `2n` (`SigabaNeo.Lattices.orderOf_gGen`), and **Lemma 8** holds for it
(`lemma8_canon`, from `ExpRing.lut_alpha_pow`, `ExpRing.lut_vcoef_pow`).
-/

namespace AdvancedEncryption.ExpLUT

open SigabaNeo.Lattices

variable {R : Type*} [CommRing R]

/-- `σ_{x^i} ∘ σ_{x^j} = σ_{x^{(i + j) mod W}}` for `x = g`, of order `W` modulo `2n`. -/
theorem σ_gGen_pow_add (E : ExpRing R) {b : ℕ} (hb : E.W = 2 ^ b) (h2 : 2 * E.W ∣ E.n) (i j : ℕ)
    (a : R) :
    E.σ (gGen E.n E.W ^ i) (E.σ (gGen E.n E.W ^ j) a) = E.σ (gGen E.n E.W ^ ((i + j) % E.W)) a := by
  have hodd := odd_gGen_pow (n := E.n) E.W_dvd
  rw [← RingHom.comp_apply, E.σ_comp _ _ (hodd i) (hodd j), ← pow_add, ← E.σ_mod,
    ← E.σ_mod (gGen E.n E.W ^ ((i + j) % E.W))]
  congr 2
  have hord := orderOf_gGen (b := b) (n := E.n) (by rw [← hb]; exact h2) E.n_pos
  rw [← hb] at hord
  have : ((gGen E.n E.W ^ (i + j) : ℕ) : ZMod (2 * E.n)) =
      ((gGen E.n E.W ^ ((i + j) % E.W) : ℕ) : ZMod (2 * E.n)) := by
    push_cast
    rw [← pow_mod_orderOf ((gGen E.n E.W : ℕ) : ZMod (2 * E.n)) (i + j), hord]
  exact (ZMod.natCast_eq_natCast_iff' _ _ _).mp this

/-- The automorphisms fix natural-number gadget entries. -/
theorem σ_g_of_natCast (E : ExpRing R) {τ : ℕ} (D : GadgetDigits R τ) (hg : ∀ i, ∃ m : ℕ, D.g i = m)
    (k : ℕ) (i : Fin τ) : E.σ k (D.g i) = D.g i := by
  obtain ⟨m, hm⟩ := hg i
  rw [hm, map_natCast]

/-- **The canonical setting**: `idx j = g^j` with `g = 1 + 2n/W`. -/
def canonSetting (E : ExpRing R) {b : ℕ} (hb : E.W = 2 ^ b) (h2 : 2 * E.W ∣ E.n) {τ : ℕ}
    (D : GadgetDigits R τ) (hg : ∀ i, ∃ m : ℕ, D.g i = m) : Setting R where
  E := E
  τ := τ
  D := D
  σ_g := σ_g_of_natCast E D hg
  b := b
  W_eq := hb
  idx j := gGen E.n E.W ^ j
  idx_odd := odd_gGen_pow E.W_dvd
  idx_zero a := by simp [E.σ_one]
  idx_add := σ_gGen_pow_add E hb h2

/-- **Lemma 8 for the canonical setting.** -/
theorem lemma8_canon (E : ExpRing R) {b : ℕ} (hb : E.W = 2 ^ b) (h2 : 2 * E.W ∣ E.n) {τ : ℕ}
    (D : GadgetDigits R τ) (hg : ∀ i, ∃ m : ℕ, D.g i = m) : Lemma8 (canonSetting E hb h2 D hg) :=
  fun L => ⟨fun _ hu => E.lut_alpha_pow hb h2 L hu, fun _ hu => E.lut_vcoef_pow hb h2 L hu⟩

end AdvancedEncryption.ExpLUT
