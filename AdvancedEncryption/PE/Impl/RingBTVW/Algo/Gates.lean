import PE.Impl.RingBTVW.Algo.KeyMatrix
import SigabaNeoStd.Lattices.Algo.FhatGates

/-!
# The number of gates of `f̂` of a gate list

For the predicate `predOf nA gs` of a gate list `gs` with `n = |gs|` NAND gates, the program `f̂`
generated by `fhatProg` at the orders of `fhatSLP` has at most

  `fhatGates N k n = 1 + n · 4kN · coefGates (2kN) k ≤ 1 + n · 4kN · (2kN + 1) · (67k + 36)`

gates (`length_fhatProg`, `fhatGates_le`). This is the `g` of `keyMatrixSteps`
(`keyMatrixStepsOf`); the step count is monotone in `g` (`keyMatrixSteps_mono`).
-/

namespace AdvancedEncryption.RingBTVW.Algo

open SigabaNeo SigabaNeo.Lattices SigabaNeo.Lattices.Algo

variable {N k : ℕ}

theorem length_predOf (n : ℕ) (gs : GateList) : (predOf n gs).1.length = gs.length := by
  simp [predOf, fromGates]

/-- **The gates of `f̂` of a gate list**: at most `fhatGates N k |gs|`. -/
theorem length_fhatProg (K : ℕ) (gs : GateList) :
    (fhatProg K (ordT₀ N k) (ordO₀ N k) gs).1.length ≤ fhatGates N k gs.length := by
  have := length_fhatSLPL₀ (N := N) (k := k) (gvExp (2 ^ K)) (2 ^ K) (predOf nA gs).1
    (predOf nA gs).2
  rwa [length_predOf] at this

/-- The same bound, as a closed polynomial in `N`, `k`, `|gs|`. -/
theorem length_fhatProg_le (K : ℕ) (gs : GateList) :
    (fhatProg K (ordT₀ N k) (ordO₀ N k) gs).1.length ≤
      1 + gs.length * (4 * k * N * ((2 * k * N + 1) * (67 * k + 36))) :=
  (length_fhatProg K gs).trans (fhatGates_le N k gs.length)

theorem keyMatrixSteps_mono (N K k : ℕ) {g g' genSteps : ℕ} (h : g ≤ g') :
    keyMatrixSteps N K k g genSteps ≤ keyMatrixSteps N K k g' genSteps := by
  unfold keyMatrixSteps slpPKSteps
  have := Nat.mul_le_mul_right (nandPKSteps N K k + 2 * (2 * k * (N * K))) h
  omega

/-- Steps of `keyMatrixW` for a gate list `gs`, with `g = fhatGates N k |gs|`. -/
def keyMatrixStepsOf (N K k : ℕ) (gs : GateList) (genSteps : ℕ) : ℕ :=
  keyMatrixSteps N K k (fhatGates N k gs.length) genSteps

/-- `keyMatrixStepsOf` bounds the step count at the actual number of gates of `f̂`. -/
theorem keyMatrixSteps_le_of (K : ℕ) (gs : GateList) (genSteps : ℕ) :
    keyMatrixSteps N K k (fhatProg K (ordT₀ N k) (ordO₀ N k) gs).1.length genSteps ≤
      keyMatrixStepsOf N K k gs genSteps :=
  keyMatrixSteps_mono N K k (length_fhatProg K gs)

end AdvancedEncryption.RingBTVW.Algo
