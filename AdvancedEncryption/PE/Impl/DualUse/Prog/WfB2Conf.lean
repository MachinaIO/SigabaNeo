    (Prog.lenBoundT (clr (mw 12)) (embedF (ValVM.mkE cntE cntE_inj)
      (Prog.lenBoundT (clrsP lowW ⨾ cp (mw GS) (mw GSC)) β1c)
      (cntOut Wc (Prog.lenBoundT (clrsP lowW ⨾ cp (mw GS) (mw GSC)) β1c))))) (tm31 j)) ≤
