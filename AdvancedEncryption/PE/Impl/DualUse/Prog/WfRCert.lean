/-! ### The checks -/

theorem chk_Vn : VT Nn Kn kn dn ≤ bsT Nn Kn kn dn 1 ∧ VT Nn Kn kn dn ≤ bsT Nn Kn kn dn 2 ∧
    (∀ t, bsT Nn Kn kn dn t ≤ Malln) ∧ VT Nn Kn kn dn ≤ Malln := by decide +kernel

theorem chk_VGn : VG Nn Kn kn dn ≤ bsG Nn Kn kn dn 1 ∧ VG Nn Kn kn dn ≤ bsG Nn Kn kn dn 2 ∧
    (∀ t, bsG Nn Kn kn dn t ≤ Malln) ∧ VG Nn Kn kn dn ≤ Malln := by decide +kernel

theorem chk_r1n : chkR (absC (bsT Nn Kn kn dn) (VT Nn Kn kn dn) (Sym.pEval [0, Nn, Kn, kn, dn] cStep2)
    Malln 30 fhatFullCR L0n) L1n (2 ^ 627) = true := by decide +kernel

theorem chk_r2n : chkR (absC (bsG Nn Kn kn dn) (VG Nn Kn kn dn) (Sym.pEval [0, Nn, Kn, kn, dn] cStepG2)
    Malln 30 gswFullCR L0Gn) L1Gn (2 ^ 525) = true := by decide +kernel

/-- Every word stays below `2^261` bits. -/
theorem chk_tapes : (∀ x ∈ L1n, x ≤ 2 ^ 261) ∧ (∀ x ∈ L1Gn, x ≤ 2 ^ 261) := by decide +kernel

theorem lenL0n : L0n.length = 120 := by simp [L0n]
theorem lenL0Gn : L0Gn.length = 120 := by simp [L0Gn]

/-- **The run of `f̂` on any register stream at `confA`**: from words below `L0n` (`|sdEnc|`,
the offsets `≤ 2^260`, the stream `≤ 2^64` bits, at most `2^50` instructions), at most `2^627`
steps, the words below `L1n` (`≤ 2^261`). -/
theorem ph_runTR_conf :
    Ph runTR (encB (bsT Nn Kn kn dn) (VT Nn Kn kn dn) (gB L0n)) (2 ^ 627)
      (encB (bsT Nn Kn kn dn) (VT Nn Kn kn dn) (gB L1n)) := by
  obtain ⟨h1, h2, h3, h4⟩ := chk_Vn
  obtain ⟨T, hT, hle⟩ := of_chkR chk_r1n
  exact (ph_runTR _ _ _ _ _ 30 _ _ _ lenL0n h1 h2 h3 h4 hT).mono le_rfl hle le_rfl

/-- **The predicate's run on any register stream at `confA`**: at most `2^525` steps. -/
theorem ph_runGR_conf :
    Ph runGR (encB (bsG Nn Kn kn dn) (VG Nn Kn kn dn) (gB L0Gn)) (2 ^ 525)
      (encB (bsG Nn Kn kn dn) (VG Nn Kn kn dn) (gB L1Gn)) := by
  obtain ⟨h1, h2, h3, h4⟩ := chk_VGn
  obtain ⟨T, hT, hle⟩ := of_chkR chk_r2n
  exact (ph_runGR _ _ _ _ _ 30 _ _ _ lenL0Gn h1 h2 h3 h4 hT).mono le_rfl hle le_rfl

/-- **The sweeps of the key sum at `confA`.** -/
theorem sweeps_conf : simKeySweeps Nn Kn dn kn (nPos Nn kn) (VT Nn Kn kn dn) (lenA Nn Kn kn 1) 1
    (VG Nn Kn kn dn) (lenA Nn Kn kn 2) ≤ 2 ^ 343 := by decide +kernel

/-- With a frame below `2^263`, the key sum takes at most `2^608` steps. -/
theorem time_simKey_conf : (2 * 2 ^ 263 + 3) * simKeySweeps Nn Kn dn kn (nPos Nn kn)
    (VT Nn Kn kn dn) (lenA Nn Kn kn 1) 1 (VG Nn Kn kn dn) (lenA Nn Kn kn 2) ≤ 2 ^ 608 :=
  (Nat.mul_le_mul_left _ sweeps_conf).trans (by decide +kernel)

