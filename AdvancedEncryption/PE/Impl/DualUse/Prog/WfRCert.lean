import PE.Impl.DualUse.Prog.WfB2Conf
import SigabaNeo.Lib.Lattices.ProgAlgo.ValRegRP

/-!
# Stage II: the runs of the `W_f` block on register streams, at the numbers of `confA`

The stage-II codes run a **stream** of register instructions (`rloopC`: the destination popped from
the stream, `3 W` bits per instruction) instead of the stage-I counter loop (`rloopG`); everything
else is the code of `WfB2` (the inputs are read with the template `T10`, whose length is the
number `nA` of inputs, so the code needs no change for `nA = 128`).

The certificates are those of `WfB2Conf` at the numbers of `BP_PLAN.md` §5.3:
`N = 2^36`, `K = 2^27`, `k = K + 1`, `d = 2^65`, `W = 512`, `nA = 128`, `|sdEnc|` and the offsets
`≤ Lb = 2^260`, the stream `≤ 2^64` bits, **at most `2^50` instructions** (the bound of the count
`GCNT`), every word `≤ Mall = 2^262`. They hold for **every** instruction stream within these
bounds: no circuit is enumerated; the circuit family enters only through the two numbers.

* `ph_runTR_conf`: the run of `f̂` takes at most `2^627` steps (≈ `2^626`) and every word stays
  `≤ 2^261` bits (`L1n`);
* `ph_runGR_conf`: the predicate's run at most `2^525` steps (≈ `2^524`), words `≤ 2^261` bits;
* `sweeps_conf`: the key sum `simKeyP` makes at most `2^343` sweeps (≈ `2^342`), i.e. with its
  frame below `2^263` at most `2^608` steps.

The word bounds `L1n`, `L1Gn` are the values of `absC` (kernel reduction, ≈ `200 s` and `55 s`),
checked here by `decide +kernel`.
-/

namespace AdvancedEncryption.DualUse.Prog

namespace WB2

open SigabaNeo SigabaNeo.Tape SigabaNeo.Tape.ValVM SigabaNeo.Tape.Prog SigabaNeo.Tape.Prog.KST
  SigabaNeo.Tape.Prog.StepT SigabaNeo.Lattices.Algo SigabaNeo.Lattices SigabaNeo.Tape.XProg

set_option maxRecDepth 100000

/-! ### The stage-II codes -/

/-- The run of `f̂` on a register stream. -/
def fhatCR : Code :=
  ofList [.gate 11 10 10, zkvC, ttkC, tt2C, insC, .cp RES TSl, cbC, .cp CBW RES, stC, rloopC nandC]
def fhatFullCR : Code := ofList [streamsT, oneC, fhatCR, .cp FOUT OUTW]
/-- The predicate's run on a register stream. -/
def gswCR : Code := ofList [insGC, .cp CBW 10, stC, rloopC (.gate RES IA IB)]
def gswFullCR : Code := ofList [.cp GS GSC, streamsG, oneC, gswCR, posC]

noncomputable def runTR : XProg 256 := (compileA (nocert (simStepP ginvTopP)) fhatFullCR).toX
noncomputable def runGR : XProg 256 := (compileA (nocert (simStepP ginvGswP)) gswFullCR).toX

theorem ph_runTR (N K k d Ms fuel : ℕ) (L L' : List ℕ) (T : ℕ) (hL : L.length = 120)
    (hV1 : VT N K k d ≤ bsT N K k d 1) (hV2 : VT N K k d ≤ bsT N K k d 2)
    (hbs : ∀ t, bsT N K k d t ≤ Ms) (hVM : VT N K k d ≤ Ms)
    (habs : absC (bsT N K k d) (VT N K k d) (Sym.pEval [0, N, K, k, d] cStep2) Ms fuel fhatFullCR L =
      some (L', T)) :
    Ph runTR (encB (bsT N K k d) (VT N K k d) (gB L)) T (encB (bsT N K k d) (VT N K k d) (gB L')) := by
  have hx := xsound_simStepP [0, N, K, k, d] trivial
  exact absC_sound (nocert _) _ _ _ _ hV1 hV2 (fun ℓ hℓ => (hx ℓ hℓ).2)
    (fun ℓ hℓ => (hx ℓ hℓ).1.trans fun t => Sym.aLe_spec _ aLe_out_top t.val)
    hbs hVM fuel fhatFullCR L L' T hL habs

theorem ph_runGR (N K k d Ms fuel : ℕ) (L L' : List ℕ) (T : ℕ) (hL : L.length = 120)
    (hV1 : VG N K k d ≤ bsG N K k d 1) (hV2 : VG N K k d ≤ bsG N K k d 2)
    (hbs : ∀ t, bsG N K k d t ≤ Ms) (hVM : VG N K k d ≤ Ms)
    (habs : absC (bsG N K k d) (VG N K k d) (Sym.pEval [0, N, K, k, d] cStepG2) Ms fuel gswFullCR L =
      some (L', T)) :
    Ph runGR (encB (bsG N K k d) (VG N K k d) (gB L)) T (encB (bsG N K k d) (VG N K k d) (gB L')) := by
  have hx := xsound_simStepG [0, N, K, k, d] trivial
  exact absC_sound (nocert _) _ _ _ _ hV1 hV2 (fun ℓ hℓ => (hx ℓ hℓ).2)
    (fun ℓ hℓ => (hx ℓ hℓ).1.trans fun t => Sym.aLe_spec _ aLe_out_gsw t.val)
    hbs hVM fuel gswFullCR L L' T hL habs

/-! ### The numbers of `confA` -/

def Nn : ℕ := 2 ^ 36
def Kn : ℕ := 2 ^ 27
def kn : ℕ := Kn + 1
def dn : ℕ := 2 ^ 65
def Wn : ℕ := 512
/-- The number of inputs. -/
def nAn : ℕ := 128
/-- A bound of `|sdEnc|` and of the stream offsets. -/
def Lbn : ℕ := 2 ^ 260
/-- A bound of the instruction stream (bits). -/
def Lgn : ℕ := 2 ^ 64
/-- **The bound of the number of instructions.** -/
def Icn : ℕ := 2 ^ 50
def M31n : ℕ := 2 ^ 160
/-- A bound of every tape. -/
def Malln : ℕ := 2 ^ 262

/-- The templates for `n` inputs (`T10`, `INSW`, `TINS`, `TW9`). -/
def fixT (n S W : ℕ) : List (Fin 256 × ℕ) → List (Fin 256 × ℕ) :=
  List.map fun x => if x.1 = mw T10 then (x.1, n) else if x.1 = mw INSW then (x.1, n * S)
    else if x.1 = mw TINS then (x.1, n * S) else if x.1 = mw TW9 then (x.1, W - n + 1) else x

/-- The input: `sdEnc` and the stream. -/
def β0n : Fin 256 → ℕ := fun t => if t = mw SDW then Lbn else if t = mw GS then Lgn else 0
def wTn : List (Fin 256 × ℕ) :=
  fixT nAn (nBI Nn Kn * VT Nn Kn kn dn) Wn (wordsTx Nn Kn kn dn Wn 66 Lbn Lbn Lbn)
/-- The words before the run of `f̂`, the instruction count at most `Icn`. -/
def vTnn : Fin 256 → ℕ := Function.update (vTn Nn Kn kn dn Wn wTn β0n M31n) (mw GCNT) Icn
def L0n : List ℕ := (List.finRange 120).map fun x => vTnn (mw x)

