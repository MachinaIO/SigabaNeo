import SigabaNeo.Lib.Lattices.Homomorphic.GSWCircuit

/-!
# The compiler of `f̂` as an explicit program

`SigabaNeo.Lattices.fhatSLP` compiles a straight-line program `p` into the Boolean program `f̂` of its
Ring-GSW evaluation, NAND block by NAND block. Two of its ingredients are not explicit:

* the gadget coefficients `((gswBin hk).G a col).coeffs t).val` (a noncomputable `abbrev`);
* the order of the terms of an output coefficient and the order of the output coefficients of a
  NAND block, `(Finset.univ : Finset _).toList`, which is chosen (`Multiset.toList` uses
  `Quot.out`), hence determined by no explicit computation.

Here the same compiler is restated with both orders as parameters `ordT`, `ordO` and the gadget
coefficients as a parameter `gv` (`coefCircuitL`, `blockStepL`, `nandBlockL`, `repOfL`,
`compileStepL`, `compileSLPL`, `fhatSLPL`). Everything else is the existing code (`leaves`,
`rounds`, `foldSum`, `constL`, … are already first-order list programs). Then:

* `fhatSLP_eq_L`: `fhatSLP hk p w = fhatSLPL ordT₀ ordO₀ (gvExp q) p w` for the chosen orders
  `ordT₀ = univ.toList`, `ordO₀ = univ.toList` and the explicit coefficients
  `gvExp q (a, col, t) = if t = 0 ∧ a = col.1 then 2^{col.2} mod q else 0` (`gvMath_eq_gvExp`).

So `f̂` is generated by an explicit first-order loop **given the two lists `ordT₀`, `ordO₀`**: these
are fixed finite permutations of explicit enumerations (`ordT_perm`, `ordO_perm`), of sizes
`2kN` and `4kN`, that a machine must hold as constants. With explicit orders in place of
`univ.toList` in `GSWCircuit` (`coefCircuit`, `nandBlock`), `fhatSLP_eq_L` would hold with explicit
lists; its correctness proofs only use that the orders enumerate each element once.
-/

namespace SigabaNeo.Lattices.Algo

open SLP Cslib

variable {N k : ℕ} {ι : Type*}

/-- `coefCircuit` with the order of the terms `ordT`. -/
def coefCircuitL (ordT : List ((Fin 2 × Fin k) × Fin N)) (z : Wire ι) (q : ℕ)
    (repA repB : BI N k → Wire ι) (Gv : ℕ) (a : Fin 2) (col : Fin 2 × Fin k) (t : Fin N)
    (p : SLP ι) : SLP ι × List (Wire ι) :=
  let r := leaves z q k repA repB a col t p ordT
  let r' := rounds z q k (treeHeight N k) r.1 (constL z k Gv :: r.2)
  foldSum z q k r'.1 r'.2

/-- `blockStep` with the order of the terms `ordT` and the gadget coefficients `gv`. -/
def blockStepL (ordT : List ((Fin 2 × Fin k) × Fin N)) (gv : OI N k → ℕ) (z : Wire ι) (q : ℕ)
    (repA repB : BI N k → Wire ι) (st : SLP ι × (OI N k → List (Wire ι))) (o : OI N k) :
    SLP ι × (OI N k → List (Wire ι)) :=
  let c := coefCircuitL ordT z q repA repB (gv o) o.1 o.2.1 o.2.2 st.1
  (c.1, Function.update st.2 o c.2)

/-- `nandBlock` with the orders `ordT`, `ordO` and the gadget coefficients `gv`. -/
def nandBlockL (ordT : List ((Fin 2 × Fin k) × Fin N)) (ordO : List (OI N k)) (gv : OI N k → ℕ)
    (z : Wire ι) (q : ℕ) (repA repB : BI N k → Wire ι) (p : SLP ι) :
    SLP ι × (BI N k → Wire ι) :=
  let r := ordO.foldl (blockStepL ordT gv z q repA repB) (p, fun _ => [])
  (r.1, fun b => (r.2 (b.1, b.2.1, b.2.2.2)).getD b.2.2.1 .one)

/-- `constRep` of the gadget, from its coefficients `gv`. -/
def constRepV (z : Wire ι) (gv : OI N k → ℕ) : BI N k → Wire ι :=
  fun b => (constL z k (gv (b.1, b.2.1, b.2.2.2))).getD b.2.2.1 .one

/-- `repOf` with the gadget coefficients `gv`. -/
def repOfL {A : Type*} (z : Wire (A × BI N k)) (gv : OI N k → ℕ)
    (reps : List (BI N k → Wire (A × BI N k))) : Wire A → BI N k → Wire (A × BI N k)
  | .input i => fun b => .input (i, b)
  | .one => constRepV z gv
  | .gate m => reps.getD m (constRepV z gv)

/-- `compileStep` with explicit orders and coefficients. -/
def compileStepL {A : Type*} (ordT : List ((Fin 2 × Fin k) × Fin N)) (ordO : List (OI N k))
    (gv : OI N k → ℕ) (z : Wire (A × BI N k)) (q : ℕ)
    (st : SLP (A × BI N k) × List (BI N k → Wire (A × BI N k))) (g : Gate A) :
    SLP (A × BI N k) × List (BI N k → Wire (A × BI N k)) :=
  let r := nandBlockL ordT ordO gv z q (repOfL z gv st.2 g.a) (repOfL z gv st.2 g.b) st.1
  (r.1, st.2 ++ [r.2])

/-- `compileSLP` with explicit orders and coefficients: one NAND block per gate of `p`. -/
def compileSLPL {A : Type*} (ordT : List ((Fin 2 × Fin k) × Fin N)) (ordO : List (OI N k))
    (gv : OI N k → ℕ) (z : Wire (A × BI N k)) (q : ℕ) (p : SLP A) (w : Wire A)
    (prog : SLP (A × BI N k)) : SLP (A × BI N k) × (BI N k → Wire (A × BI N k)) :=
  let st := p.foldl (compileStepL ordT ordO gv z q) (prog, [])
  (st.1, repOfL z gv st.2 w)

/-- **`f̂` as an explicit program** of the orders and coefficients: a gate computing `0`, then one
NAND block per gate of `p`. -/
def fhatSLPL {A : Type*} (ordT : List ((Fin 2 × Fin k) × Fin N)) (ordO : List (OI N k))
    (gv : OI N k → ℕ) (q : ℕ) (p : SLP A) (w : Wire A) :
    SLP (A × BI N k) × (BI N k → Wire (A × BI N k)) :=
  compileSLPL ordT ordO gv (.gate 0) q p w [⟨.one, .one⟩]

/-! ### Equality with `fhatSLP` -/

variable {q : ℕ} [NeZero q]

/-- The gadget coefficients, as in `blockStep`. -/
noncomputable def gvMath (hk : q < 2 ^ k) : OI N k → ℕ :=
  fun o => (((gswBin (N := N) hk).G o.1 o.2.1).coeffs o.2.2).val

/-- **The gadget coefficients, explicitly**: `2^{col.2} mod q` at the constant coefficient of the
entries `(a, col)` with `col.1 = a`. -/
def gvExp (q : ℕ) : OI N k → ℕ :=
  fun o => if o.2.2.val = 0 ∧ o.1 = o.2.1.1 then 2 ^ o.2.1.2.val % q else 0

theorem gvMath_eq_gvExp (hk : q < 2 ^ k) : gvMath (N := N) hk = gvExp q := by
  funext o
  obtain ⟨a, ⟨c₁, c₂⟩, t⟩ := o
  simp only [gvMath, gvExp, gswBin, gswGadget, gadgetOf, Matrix.of_apply, id, binaryDigits]
  have h2 : ((2 : ZMod q) ^ (c₂ : ℕ)) = ((2 ^ (c₂ : ℕ) : ℕ) : ZMod q) := by push_cast; rfl
  by_cases ha : a = c₁
  · subst ha
    simp only [ite_true, and_true]
    rw [Negacyclic.coeffs_algebraMap]
    by_cases ht : t.val = 0
    · simp only [ht, ite_true, h2, ZMod.val_natCast]
    · simp [ht]
  · simp [ha]

/-- The order of the terms (explicit: `enumT`). -/
def ordT₀ (N k : ℕ) : List ((Fin 2 × Fin k) × Fin N) := enumT N k

/-- The order of the output coefficients (explicit: `enumO`). -/
def ordO₀ (N k : ℕ) : List (OI N k) := enumO N k

theorem ordT_perm (l : List ((Fin 2 × Fin k) × Fin N)) (hl : l.Nodup) (hc : ∀ e, e ∈ l) :
    (ordT₀ N k).Perm l := by
  unfold ordT₀
  rw [List.perm_ext_iff_of_nodup (nodup_enumT N k) hl]
  intro e; simp [hc, mem_enumT]

theorem ordO_perm (l : List (OI N k)) (hl : l.Nodup) (hc : ∀ e, e ∈ l) :
    (ordO₀ N k).Perm l := by
  unfold ordO₀
  rw [List.perm_ext_iff_of_nodup (nodup_enumO N k) hl]
  intro e; simp [hc, mem_enumO]

theorem fhatSLP_eq_L_math {A : Type*} (hk : q < 2 ^ k) (p : SLP A) (w : Wire A) :
    fhatSLP (N := N) hk p w = fhatSLPL (ordT₀ N k) (ordO₀ N k) (gvMath hk) q p w := rfl

/-- **`f̂` is the explicit program** `fhatSLPL` at the chosen orders. -/
theorem fhatSLP_eq_L {A : Type*} (hk : q < 2 ^ k) (p : SLP A) (w : Wire A) :
    fhatSLP (N := N) hk p w = fhatSLPL (ordT₀ N k) (ordO₀ N k) (gvExp q) q p w := by
  rw [fhatSLP_eq_L_math, gvMath_eq_gvExp]

end SigabaNeo.Lattices.Algo
