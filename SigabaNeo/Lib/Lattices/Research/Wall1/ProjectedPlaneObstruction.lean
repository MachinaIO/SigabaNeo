module

public import SigabaNeo.Lib.Lattices.Research.Wall1.TernaryHermite

public section

namespace SigabaNeo.Wall1

/-! The integer lattice generated by (10,0,0), (5,10,0), (0,5,9).
Projection along the first generator drops the first coordinate. -/

private theorem sq_ge_one (z : ℤ) (hz : z ≠ 0) : 1 ≤ z^2 := by
  have := sq_pos_of_ne_zero hz
  omega

/-- The projected squared length exceeds 100 whenever the third coefficient is nonzero. -/
theorem projectedPlane_third_long (j k : ℤ) (hk : k ≠ 0) :
    100 < (10*j + 5*k)^2 + (9*k)^2 := by
  by_cases h : k = 1 ∨ k = -1
  · have hy : 2*j+k ≠ 0 := by omega
    nlinarith [sq_ge_one (2*j+k) hy, sq_ge_one k hk]
  · have hsq : 4 ≤ k^2 := by
      rcases (show k ≤ -2 ∨ 2 ≤ k by omega) with h | h
      · nlinarith [mul_nonneg (show 0 ≤ -k-2 by omega) (show 0 ≤ -k+2 by omega)]
      · nlinarith [mul_nonneg (show 0 ≤ k-2 by omega) (show 0 ≤ k+2 by omega)]
    nlinarith [sq_nonneg (10*j+5*k)]

/-- Only the two signs of the second projected generator attain its length. -/
theorem projectedPlane_short_direction (j k : ℤ) (hn : j ≠ 0 ∨ k ≠ 0)
    (hs : (10*j+5*k)^2 + (9*k)^2 ≤ 100) : k = 0 ∧ (j = 1 ∨ j = -1) := by
  have hk : k = 0 := by
    by_contra h
    exact (not_lt_of_ge hs) (projectedPlane_third_long j k h)
  subst k
  refine ⟨rfl, ?_⟩
  have hsq : j^2 ≤ 1 := by nlinarith
  have habs : -1 ≤ j ∧ j ≤ 1 := by constructor <;> nlinarith [sq_nonneg (j+1), sq_nonneg (j-1)]
  omega

/-- The first generator is unique up to sign at squared length at most 100. -/
theorem projectedPlane_first_direction (i j k : ℤ)
    (hs : (10*i+5*j)^2 + (10*j+5*k)^2 + (9*k)^2 ≤ 100) : j = 0 ∧ k = 0 ∧ -1 ≤ i ∧ i ≤ 1 := by
  by_cases h : j ≠ 0 ∨ k ≠ 0
  · obtain ⟨rfl, hj⟩ := projectedPlane_short_direction j k h (by nlinarith [sq_nonneg (10*i+5*j)])
    rcases hj with rfl | rfl <;> exfalso <;>
      nlinarith [sq_ge_one (10*i+5) (by omega), sq_ge_one (10*i-5) (by omega)]
  · push_neg at h
    obtain ⟨rfl,rfl⟩ := h
    refine ⟨rfl,rfl, ?_, ?_⟩ <;> nlinarith [sq_nonneg (i+1), sq_nonneg (i-1)]

/-- Every reduced lift of the shortest projected direction has horizontal offset ±5.
The third height squared is 81 and the accepted algebraic lemma's premise fails. -/
theorem projectedPlane_cover_fails :
    ¬ (4 * ((100:ℝ)*125-50^2) * (125-81) ≤ 100*125*(100+125-2*50)) := by
  norm_num

end SigabaNeo.Wall1
