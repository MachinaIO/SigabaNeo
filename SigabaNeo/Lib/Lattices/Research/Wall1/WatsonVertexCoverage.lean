import SigabaNeo.Lib.Lattices.Research.Wall1.WatsonGramFeasible
import SigabaNeo.Lib.Lattices.Research.Wall1.HermiteRootExamples

/-! # Vertex coverage for the rank-five Gram polytope

Maximize a linear functional over the finite set of signed images. At the winning representative,
maximize the same functional over the offsets of its local frames. For each of the ten directions
of the winning frame, one of these two maxima shows that the functional cannot increase. The
checked normal-direction products are diagonal with positive diagonal. Consequently every feasible
displacement has nonnegative coordinates in this frame, so it cannot increase the functional
either. Separation gives convex-hull containment, and feasibility gives the reverse inclusion.

The 448 frames were generated by perturbing the tight inequalities at each representative.
Their optimality witnesses are checked in integer arithmetic in `WatsonPivotChecks`. -/

noncomputable section
namespace SigabaNeo.Wall1.Watson
namespace Pivot

open Matrix Finset

def orbitPoint (u : Fin 24 × Action) := u.2.map (gramVertex u.1)

set_option maxRecDepth 8192 in
private theorem support (A : M) (hA : A ∈ gramPolytope) (f : M →ₗ[ℝ] ℝ) :
    ∃ u, f A ≤ f (orbitPoint u) := by
  classical
  let : Nonempty Action := ⟨⟨Equiv.refl _, fun _ ↦ false⟩⟩
  obtain ⟨⟨k,a⟩,_,best⟩ := exists_max_image univ (fun u ↦ f (orbitPoint u)) univ_nonempty
  let X := a.inv.map A
  have hx := a.inv.map_mem hA
  have eq : chart (coords X) = X := chart_coords hx.1.1.2 hx.1.2
  let g := (f.comp a.map).comp edgeMap
  have transform (x : E) : f (a.map (chart x)) = f (a.map 1) + g x := by simp [chart,g]
  have parts := checks k
  have localBound := block_bound (centers k) (blocks k) g (coords X) parts.1 parts.2.1
  have comparison := localBound (fun j i ↦ by
    let z := row (blocks k) j i
    obtain ⟨ht,pos,zero,_⟩ := parts.2.2.1 j i
    have hn : z ≠ 0 := by
      intro he
      change 0 < sqSum z at pos
      simp [he,sqSum] at pos
    have htest := hx.2 z hn ht
    have en := chart_energy (coords X) z
    rw [eq] at en
    have zz : (slackInt (centers k) z : ℝ) = 0 := by exact_mod_cast zero
    simp only [slackInt,Int.cast_add,Int.cast_mul,Int.cast_ofNat,Int.cast_sub,Int.cast_one,
      dot_cast] at zz
    change 0 ≤ lift (normal z) ⬝ᵥ (coords X - lift (centers k))
    rw [dotProduct_sub]
    linarith) (fun j i outside ↦ by
    let t := dest (blocks k) j i - (blocks k).frames.size
    have bound := (parts.2.2.1 j i).2.2.2
    have ht : t < (blocks k).images.size := by dsimp [t]; omega
    let im := imageAt (blocks k) t
    obtain ⟨b,hb⟩ := chart_image (im := im) (parts.2.2.2 ⟨t,ht⟩)
    have hh := best (im.rep,a.comp b) (mem_univ _)
    change f ((a.comp b).map (gramVertex im.rep)) ≤ f (a.map (gramVertex k)) at hh
    rw [Action.map_comp,← hb,← chart_center,transform,transform] at hh
    exact le_of_add_le_add_left hh)
  refine ⟨(k,a),?_⟩
  change f A ≤ f (a.map (gramVertex k))
  have back : a.map (chart (coords X)) = A := (congrArg a.map eq).trans (a.map_inv A)
  rw [← back,← chart_center,transform,transform]
  linarith

/-- The two descriptions agree on all real matrices, including the boundary. -/
theorem polytope_eq_hull : gramPolytope = convexHull ℝ (Set.range orbitPoint) := by
  classical
  let : LocallyConvexSpace ℝ M := inferInstanceAs (LocallyConvexSpace ℝ (I → I → ℝ))
  apply Set.Subset.antisymm
  · intro A hA
    by_contra h
    obtain ⟨f,u,hf,hu⟩ := geometric_hahn_banach_closed_point (convex_convexHull ℝ _)
      ((Set.finite_range orbitPoint).isCompact_convexHull ℝ).isClosed h
    obtain ⟨v,hv⟩ := support A hA f.toLinearMap
    exact (hf _ (subset_convexHull ℝ _ (Set.mem_range_self v))).not_ge (hu.le.trans hv)
  · apply convexHull_min
    · rintro _ ⟨⟨k,a⟩,rfl⟩
      exact a.map_mem (center_mem k)
    · intro X hX Y hY a b ha hb hab
      obtain ⟨⟨⟨xB,xS⟩,xD⟩,xT⟩ := hX
      obtain ⟨⟨⟨yB,yS⟩,yD⟩,yT⟩ := hY
      refine ⟨⟨⟨fun i j ↦ convex_Icc _ _ (xB i j) (yB i j) ha hb hab,?_⟩,fun i ↦ ?_⟩,
        fun z hn ht ↦ ?_⟩
      · exact (IsSelfAdjoint.smul (IsSelfAdjoint.of_nonneg ha) xS).add
          (IsSelfAdjoint.smul (IsSelfAdjoint.of_nonneg hb) yS)
      · simp [xD i,yD i,hab]
      · have eq : gramValue (a • X + b • Y) z = a * gramValue X z + b * gramValue Y z := by
          simp [gramValue,add_mulVec,smul_mulVec,dotProduct_add,dotProduct_smul]
        rw [eq]
        linarith [mul_le_mul_of_nonneg_left (xT z hn ht) ha,
          mul_le_mul_of_nonneg_left (yT z hn ht) hb]

end Pivot

open Matrix Pivot

theorem vertexCoverage : VertexCoverage := by
  intro A hA
  rw [polytope_eq_hull] at hA
  obtain ⟨⟨k,a⟩,rfl⟩ := extremePoints_convexHull_subset hA
  refine ⟨k,a.perm,coeff a.flip,coeff_abs _,?_⟩
  ext i j
  simp [orbitPoint,diagonal_mul,mul_diagonal,mul_comm,mul_left_comm,mul_assoc]

/-- The sharp tenth-power bound for every shortest vector of a full rank-five lattice. -/
theorem rank_five {L : Submodule ℤ (TerminalProjection.CoordSpace 5)}
    [DiscreteTopology L] [IsZLattice ℝ L] {v : TerminalProjection.CoordSpace 5}
    (hv : DecoupledDecoder.IsShortest (L : Set (TerminalProjection.CoordSpace 5)) v) :
    ‖v‖^10 ≤ 8 * ZLattice.covolume L^2 :=
  rank_five_of_finite_gram (finite_gram_of_vertex_coverage vertexCoverage) L hv

open ControlledPlane TerminalProjection TerminalProjection.Restart506 DualExit

/-- Eight is attained and is the optimal fifth power of the intrinsic Hermite constant. -/
theorem sharp_five : IsLeast {t : ℝ | ∃ g, IntrinsicHermite 5 g ∧ t = g^5} 8 := by
  have eg : flagGamma 5 ^ 5 = 8 := by
    change Real.exp (Real.log 8 / 5) ^ 5 = 8
    rw [← Real.exp_nat_mul]
    convert Real.exp_log (by norm_num : (0:ℝ) < 8) using 2
    ring
  refine ⟨⟨_,intrinsic_five_of_finite_gram (finite_gram_of_vertex_coverage vertexCoverage),
    eg.symm⟩,?_⟩
  rintro _ ⟨g,h,rfl⟩
  have := necessary_hermite 5 (by decide) (by decide) h
  norm_num at this
  linarith

local instance : Fact (Nat.Prime 3329) := ⟨by norm_num⟩

theorem terminal_bound_of_six_seven_twentyfour
    (h6 : IntrinsicHermite 6 (flagGamma 6)) (h7 : IntrinsicHermite 7 (flagGamma 7))
    (h24 : IntrinsicHermite 24 4) :
    probability terminalHit < probability residual₁ + probability residual₂ + 6.515/(10:ℝ)^12 :=
  terminal_bound_of_vertex_coverage vertexCoverage h6 h7 h24

end SigabaNeo.Wall1.Watson

