/-- Integral lattice generated by the rows with zero-based index strictly below k. -/
def prefixLattice {n : ℕ} {E : Type*} [AddCommGroup E] (b : Fin n → E) (k : ℕ) :=
  Submodule.span ℤ (b '' {i | i.val < k})

/-- Coordinates outside a real prefix vanish integrally for points of the lattice. -/
theorem mem_prefixLattice_of_mem_real_span {n : ℕ} {M E : Type*} [AddCommGroup M]
    [AddCommGroup E] [Module ℝ E] (f : M →+ E) (b : Fin n → M)
    (hb : LinearIndependent ℝ (f ∘ b)) {k : ℕ} {u : M}
    (hu : u ∈ Submodule.span ℤ (Set.range b))
    (hw : f u ∈ Submodule.span ℝ ((f ∘ b) '' {i | i.val < k})) :
    u ∈ prefixLattice b k := by
  classical
  obtain ⟨z, hz⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hu
  obtain ⟨c, hc, he⟩ := (Finsupp.mem_span_image_iff_linearCombination ℝ).mp hw
  have eq : (fun i ↦ (z i : ℝ)) = ⇑c := by
    apply hb.fintypeLinearCombination_injective
    change ∑ i, (z i : ℝ) • f (b i) = ∑ i, c i • f (b i)
    rw [← Finsupp.sum_fintype c (fun i a ↦ a • f (b i)) (fun i ↦ zero_smul ℝ _)]
    rw [show c.sum (fun i a ↦ a • f (b i)) = f u from he, ← hz, map_sum]
    simp [map_zsmul, Int.cast_smul_eq_zsmul]
  rw [← hz]
  apply Submodule.sum_mem
  intro i _
  by_cases hi : i.val < k
  · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, hi, rfl⟩)
  · have zero : c i = 0 := Finsupp.notMem_support_iff.mp (fun h ↦ hi (hc h))
    have zi : z i = 0 := by exact_mod_cast (congrFun eq i).trans zero
    simp [zi]

open InnerProductSpace BKZ

/-- A unique shortest pair in a nonempty prefix covered by the first BKZ block is captured. -/
theorem bkz_contained_capture {n β k : ℕ} (b : Fin n → EuclideanSpace ℝ (Fin n))
    (hb : LinearIndependent ℝ b) (hr : Reduced b hb β) (hk : 0 < k) (hn : k ≤ n)
    (hβ : k ≤ β) (u : EuclideanSpace ℝ (Fin n)) (hu : u ∈ prefixLattice b k) (hne : u ≠ 0)
    (gap : ∀ w ∈ prefixLattice b k, w ≠ 0 → w ≠ u → w ≠ -u → ‖u‖ < ‖w‖) :
    b ⟨0, by omega⟩ = u ∨ b ⟨0, by omega⟩ = -u := by
  classical
  let : NeZero n := ⟨by omega⟩
  obtain ⟨z, hs, hz⟩ := (Finsupp.mem_span_image_iff_linearCombination ℤ).mp hu
  have sum_eq : ∑ i, z i • b i = u :=
    (Finsupp.sum_fintype z (fun i a ↦ a • b i) fun i ↦ zero_smul ℤ (b i)).symm.trans hz
  have nonempty : z.support.Nonempty := by
    by_contra! he
    have : z = 0 := Finsupp.support_eq_empty.mp he
    simp_all
  let t := z.support.max' nonempty
  have ht : t ∈ z.support := z.support.max'_mem nonempty
  have tk : t.val < k := hs ht
  have le := covering_block_bound b hb hr z t (0 : Fin n) (Finsupp.mem_support_iff.mp ht)
    (fun j hj ↦ by
      by_contra nz
      exact hj.not_ge (z.support.le_max' j (Finsupp.mem_support_iff.mpr nz)))
    (Fin.zero_le _) (by simp; omega)
  rw [sum_eq, gramSchmidt_def] at le
  have empty : Finset.Iio (0 : Fin n) = ∅ := Finset.eq_empty_iff_forall_notMem.mpr
    fun j hj ↦ Nat.not_lt_zero j.val (show j < (0 : Fin n) from Finset.mem_Iio.mp hj)
  rw [empty, Finset.sum_empty, sub_zero] at le
  by_contra! miss
  exact (gap _ (Submodule.subset_span ⟨0, hk, rfl⟩) (hb.ne_zero _) miss.1 miss.2).not_ge le

open Slide Matrix

/-- Checked slide bases use rational squared Euclidean lengths in their exact primal test. -/
theorem slide_contained_capture {blocks β d k : ℕ} (B : Matrix (Fin (blocks*β)) (Fin d) ℤ)
    (hb : LinearIndependent ℤ B) (pos : 0 < β) {q : ℚ} (ok : slideCheck B pos q = true)
    (hk : 0 < k) (hn : k ≤ blocks*β) (hβ : k ≤ β) (u : Fin d → ℤ)
    (hu : u ∈ prefixLattice B k) (hne : u ≠ 0)
    (gap : ∀ w ∈ prefixLattice B k, w ≠ 0 → w ≠ u → w ≠ -u →
      (∑ j, (u j : ℚ)^2) < ∑ j, (w j : ℚ)^2) :
    B ⟨0, by omega⟩ = u ∨ B ⟨0, by omega⟩ = -u := by
  classical
  have hbpos : 0 < blocks := by by_contra! h; simp_all
  have fit : β ≤ blocks*β := by simpa using Nat.mul_le_mul_right β hbpos
  let rows (i : Fin β) := B (i.castLE fit)
  have mem : u ∈ Submodule.span ℤ (Set.range rows) := by
    apply Submodule.span_mono _ hu
    rintro _ ⟨j, hj, rfl⟩
    exact ⟨⟨j.val, lt_of_lt_of_le hj hβ⟩, rfl⟩
  obtain ⟨z, hz⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp mem
  let i : Fin blocks := ⟨0,hbpos⟩
  have fits : i.val*β+β ≤ blocks*β := by simpa [i] using fit
  let A := blockAt B (i.val*β) β fits
  have row (r : Fin β) (j : Fin d) : A r j = (rows r j : ℚ) := by
    change (B ⟨i.val*β+r.val, by have := r.isLt; omega⟩ j : ℚ) -
      (∑ l : Fin (i.val*β), _ * _) = _
    simp [i, rows, Fin.castLE]
  have vz (j : Fin d) : vector A z j = (u j : ℚ) := by
    have eq := congrFun hz j
    simp only [Finset.sum_apply, zsmul_eq_mul] at eq
    simpa [vector, vecMul, dotProduct, row] using congrArg (Int.cast : ℤ → ℚ) eq
  have nz : vector A z ≠ 0 := by
    intro e
    apply hne
    ext j
    have h : (u j : ℚ) = 0 := (vz j).symm.trans (congrFun e j)
    exact_mod_cast h
  have le := slideCheck_primal B pos ok i fits z (block_regular B hb _ _ fits) nz
  change weight A _ ≤ weight A z at le
  have single (j : Fin d) : vector A (Pi.single ⟨0,pos⟩ 1) j = (B ⟨0,by omega⟩ j : ℚ) := by
    simpa [vector, vecMul, dotProduct, Pi.single_apply, apply_ite, rows] using row ⟨0,pos⟩ j
  simp only [weight, vz, single] at le
  by_contra! miss
  exact (gap _ (Submodule.subset_span ⟨⟨0,by omega⟩, hk, rfl⟩)
    (hb.ne_zero _) miss.1 miss.2).not_ge le

open QAry LLL.Algorithm
open scoped Matrix

private noncomputable def euclideanRow {d : ℕ} : (Fin d → ℤ) →+ EuclideanSpace ℝ (Fin d) where
  toFun z := WithLp.toLp 2 fun j ↦ (z j : ℝ)
  map_zero' := by ext; simp
  map_add' x y := by ext; simp

private theorem independent_euclideanRow {r d : ℕ} (shape : r = d) (B : Rows r d)
    (hb : LinearIndependent ℤ B) : LinearIndependent ℝ (euclideanRow ∘ B) := by
  subst d
  convert realRows_independent B hb using 1
  ext i j
  simp [Function.comp, euclideanRow, realRows, realVec, rationalRow]

/-- Pointwise contained implication for the selected output of the registered slide loop.
The prefix rank preceding the terminal block is blocks*β-β. -/
theorem selected_contained_capture {m n q β blocks : ℕ} [Fact q.Prime]
    (pos : 0 < β) (shape : blocks*β = dim m n)
    (e : Fin m → ℤ) (s : Fin n → ℤ) (A : Matrix (Fin m) (Fin n) (ZMod q))
    (shortPrefix : blocks*β-β ≤ β)
    (gap : let c := fun i ↦ A i ⬝ᵥ (fun j ↦ (s j : ZMod q)) + e i
           let u := Planted.plantedPoint e s ∘ indexEquiv.symm
           ∀ w ∈ prefixLattice (selectedRows pos shape A c) (blocks*β-β),
             w ≠ 0 → w ≠ u → w ≠ -u → (∑ j, (u j : ℚ)^2) < ∑ j, (w j : ℚ)^2)
    (inside : prefixContainsPlant pos shape e s A) : captured pos shape e s A := by
  classical
  let c := fun i ↦ A i ⬝ᵥ (fun j ↦ (s j : ZMod q)) + e i
  let B := selectedRows pos shape A c
  let u := Planted.plantedPoint e s ∘ indexEquiv.symm
  let input : SlideBasis β blocks (dim m n) := ⟨fun i ↦ rows A c (Fin.cast shape i),
    (rows_independent A c).comp _ (finCongr shape).injective⟩
  have spec := slide_reduce_eps pos (1/10) (by norm_num) input
  have ok : slideCheck B pos ((1+1/10)^2) = true := spec.2.2
  have hb : LinearIndependent ℤ B := (slideLoop (slidePass pos ((1+1/10)^2)) _ input).1.property
  have hu : u ∈ lattice B := by
    rw [show lattice B = lattice input.val from spec.2.1]
    have ranges : Set.range input.val = Set.range (rows A c) :=
      (finCongr shape).surjective.range_comp (rows A c)
    rw [lattice, ranges]
    apply (rows_span_iff_member A c u).mpr
    intro i
    simp [u, c, Planted.plantedPoint, QAry.col, QAry.last, add_comm]
  have nz : u ≠ 0 := by
    intro h
    have he := congrFun h (indexEquiv (.inr (.inr ())))
    simp [u, Planted.plantedPoint] at he
  have mem : u ∈ prefixLattice B (blocks*β-β) := by
    apply mem_prefixLattice_of_mem_real_span euclideanRow B (independent_euclideanRow shape B hb) hu
    change euclideanRow u ∈ Submodule.span ℝ (Set.range _) at inside
    convert inside using 2
    exact Set.image_eq_range _ _
  have nonempty : 0 < blocks*β-β := by
    by_contra! h
    have zero : blocks*β-β = 0 := by omega
    have bot : prefixLattice B (blocks*β-β) ≤ ⊥ := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      change i.val < blocks*β-β at hi
      omega
    exact nz (bot mem)
  exact ⟨_, slide_contained_capture B hb pos ok nonempty (Nat.sub_le ..) shortPrefix u mem nz gap⟩

