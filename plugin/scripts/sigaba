#!/usr/bin/env python3
"""The Sigaba-Neo plugin's launcher (Claude Code and Codex). Standard library only.

    sigaba install [--rev REV] [--no-build]   clone the core at the plugin's pinned revision (or
                                             REV) into $SIGABA_HOME/releases/, build it, and make
                                             it current; also writes $SIGABA_HOME/bin/sigaba
    sigaba upgrade [--no-build]              the same for the plugin's current pin
    sigaba where                             the current core, its revision, the shim
    sigaba uninstall                         remove the shim and the `core` link (releases, state
                                             and worktrees are kept)
    sigaba COMMAND ...                       the controller: python/sigaba_research.py of the
                                             current core (docs/RESEARCH_PROTOCOL.md)

$SIGABA_HOME defaults to ~/.sigaba. $SIGABA_CORE, if set, is used as the core instead (a
development checkout).
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

PLUGIN = Path(__file__).resolve().parents[1]
HOME = Path(os.environ.get("SIGABA_HOME", "~/.sigaba")).expanduser()
CSLIB_CACHE = {"LAKE_CACHE_ARTIFACT_ENDPOINT":
               "https://storage.googleapis.com/complexitylib-lake-cache/a0",
               "LAKE_CACHE_REVISION_ENDPOINT":
               "https://storage.googleapis.com/complexitylib-lake-cache/r0"}


def say(obj) -> None:
    print(json.dumps(obj, indent=1))


def pin() -> dict:
    return json.loads((PLUGIN / "core.json").read_text())


def core() -> Path | None:
    if os.environ.get("SIGABA_CORE"):
        return Path(os.environ["SIGABA_CORE"]).expanduser().resolve()
    link = HOME / "core"
    return link.resolve() if link.exists() else None


def run(argv: list[str], cwd: Path | None = None, env: dict | None = None,
        check: bool = True) -> subprocess.CompletedProcess:
    print("+ " + " ".join(argv), file=sys.stderr, flush=True)
    return subprocess.run(argv, cwd=cwd, env={**os.environ, **(env or {})}, check=check)


def install(rev: str | None, build: bool) -> None:
    p = pin()
    rev = rev or p["rev"]
    for tool in ("git", "python3") + (("lake",) if build else ()):
        if shutil.which(tool) is None:
            raise SystemExit(f"{tool} is not installed (Lean: https://lean-lang.org/install)")
    rel = HOME / "releases"
    rel.mkdir(parents=True, exist_ok=True)
    staging = rel / ".staging"
    if staging.exists():
        shutil.rmtree(staging)
    run(["git", "clone", "--quiet", p["url"], str(staging)])
    if run(["git", "-C", str(staging), "checkout", "--quiet", "--detach", rev],
           check=False).returncode != 0:      # a branch name: the remote's
        run(["git", "-C", str(staging), "checkout", "--quiet", "--detach", f"origin/{rev}"])
    sha = subprocess.run(["git", "-C", str(staging), "rev-parse", "HEAD"], capture_output=True,
                         text=True, check=True).stdout.strip()
    dest = rel / sha[:12]
    if dest.exists():
        shutil.rmtree(staging)
    else:
        staging.rename(dest)
    if build:
        run(["lake", "exe", "cache", "get"], cwd=dest, check=False)
        run(["lake", "cache", "get", "--package=cslib-frontier",
             "--repo=cslib-community/complexitylib"], cwd=dest, env=CSLIB_CACHE, check=False)
        run(["lake", "build"], cwd=dest)
    link = HOME / "core"
    tmp = HOME / ".core.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(dest)
    tmp.replace(link)
    shim = HOME / "bin" / "sigaba"
    shim.parent.mkdir(parents=True, exist_ok=True)
    shim.write_text("#!/bin/sh\n"
                    f'exec python3 "{link}/python/sigaba_research.py" "$@"\n')
    shim.chmod(0o755)
    say({"core": str(dest), "revision": sha, "built": build, "shim": str(shim),
         "next": f"{shim} doctor"})


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd in ("install", "upgrade"):
        rev = argv[argv.index("--rev") + 1] if "--rev" in argv else None
        install(rev, "--no-build" not in argv)
        return 0
    if cmd == "where":
        c = core()
        say({"core": str(c) if c else None, "pin": pin(), "home": str(HOME),
             "shim": str(HOME / "bin" / "sigaba"),
             "revision": subprocess.run(["git", "-C", str(c), "rev-parse", "HEAD"],
                                        capture_output=True, text=True).stdout.strip()
             if c else None})
        return 0
    if cmd == "uninstall":
        for p in (HOME / "bin" / "sigaba", HOME / "core"):
            if p.is_symlink() or p.exists():
                p.unlink()
        say({"removed": ["bin/sigaba", "core"], "kept": str(HOME)})
        return 0
    c = core()
    if c is None or not (c / "python" / "sigaba_research.py").exists():
        print(json.dumps({"error": "the Sigaba-Neo core is not installed: run "
                          f"`{Path(__file__).resolve()} install`"}))
        return 2
    os.execvp(sys.executable, [sys.executable, str(c / "python" / "sigaba_research.py"), *argv])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
